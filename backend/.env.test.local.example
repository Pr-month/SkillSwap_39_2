# APP
PORT=3000
HASH_SALT=10
NODE_ENV=test

# DB
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SYNCHRONIZE=true
DB_LOGGING=true

# JWT
ACCESS_TOKEN_KEY=secret-dev
ACCESS_TOKEN_EXPIRY=10m
REFRESH_TOKEN_KEY=secret-dev
REFRESH_TOKEN_EXPIRY=7d

# FILES
FILES_PATH_TEMP=public/test-temp
FILES_PATH_IMG=public/test-uploads

# ADMIN
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=admin123

# SWAGGER
SWAGGER_TITLE=SkillSwap API
SWAGGER_DESCRIPTION=API documentation for SkillSwap platform
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs
SWAGGER_ENABLED=false
