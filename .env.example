# APP
PORT=3000
HASH_SALT=10
NODE_ENV=development

# DB — matches Postgres service in main: .github/workflows/ci.yml (POSTGRES_* / DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
ACCESS_TOKEN_KEY=secret-dev
ACCESS_TOKEN_EXPIRY=10m
REFRESH_TOKEN_KEY=secret-dev
REFRESH_TOKEN_EXPIRY=7d

# FILES
FILES_PATH_TEMP=public/temp
FILES_PATH_IMG=public/uploads

#ADMIN
ADMIN_EMAIL=admin@mail.com
ADMIN_PASSWORD=admin123